{
  "input_path": "./datasets/dev/inputs.json",
  "label_path": "./datasets/dev/labels.json",
  "output_directory": "./results",
  "evaluator": {
    "id": "current-heuristic"
  },
  "concurrency": 4,
  "retry": {
    "max_attempts": 2,
    "initial_delay_ms": 100,
    "max_delay_ms": 1000
  },
  "experimental_mode": true,
  "resume": true,
  "retry_failed_on_resume": false,
  "bootstrap": {
    "seed": "agenteval-v1-dev",
    "iterations": 1000,
    "confidence_level": 0.95
  }
}
